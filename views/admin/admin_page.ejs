<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>zoom - Create Invite</title>

  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="css/admin_page.css">
</head>

<body>

  <!-- Topbar -->
  <div class="topbar">
    <a class="brand" href="/">
      <div class="logo">Z</div>
      <div class="name">Zoom</div>
    </a>

    <div class="top-right">
      <a href="#" class="support">Support</a>
      <a href="#" class="signup">Sign Up Free</a>
    </div>
  </div>

  <!-- Form -->
  <div class="form-wrap">
    <div class="card-lite">
      <h3 class="mb-3">Create Invite</h3>

      <!-- Using id attributes so you can plug server POST easily later -->
      <form id="inviteForm" action="/admin_page" autocomplete="off" novalidate method="post">
        <div class="mb-3 text-start">
          <label class="form-label small">Name</label>
          <input id="name" name="name" type="text" class="form-control" placeholder="Enter Name" required>
        </div>

        <div class="mb-3 text-start">
          <label class="form-label small">Email</label>
          <input id="email" name="email" type="email" class="form-control" placeholder="Enter Email" required>
        </div>

        <button id="createBtn" class="btn-locker" type="submit">Create Link</button>
      </form>

      <!-- Generated link area -->
      <% if (dbLink && dbLink.link) { %>
        <div class="mt-4 text-center">
          <h6 class="text-success">✅ Link generated successfully:</h6>
          <div class="input-group mt-2">
            <input type="text" id="inviteLink" class="form-control" value="<%= dbLink.link %>" readonly>
            <% } else { %>
              <p>No link has been generated yet.</p>
              <button class="btn btn-primary" type="button" onclick="copyLink()">Copy</button>
          </div>
        </div>
        <% } %>
    </div>

  </div>

  <div class="footer">
    © <span id="year"></span> Locker. All rights reserved. Privacy & Legal Policies
  </div>
  </div>

  <!-- Bootstrap JS (for any components) -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    function copyLink() {
      const input = document.getElementById('inviteLink');
      input.select();
      document.execCommand('copy');
      alert('Link copied to clipboard!');
    }
  </script>
</body>

</html>